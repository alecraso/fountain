{
  "name": "error-402-with-retired-code-keeps-purchase-url",
  "title": "HTTP 402 still carries the purchase URL with an unknown code",
  "contract": "errors",
  "why": "Removing a wire alias must preserve generic HTTP 402 classification and its purchase URL.",
  "client": {
    "api_key": "conformance-key"
  },
  "http": [
    {
      "match": {
        "method": "POST",
        "path": "/api/conversations"
      },
      "respond": {
        "status": 402,
        "json": {
          "error": "subscription_required",
          "upgrade_url": "/account/billing"
        }
      }
    }
  ],
  "steps": [
    {
      "op": "run",
      "agent": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee",
      "prompt": "hello"
    }
  ],
  "expect": {
    "error": {
      "kind": "insufficient_credits",
      "status": 402,
      "code": "subscription_required",
      "upgrade_url": "/account/billing",
      "retryable": false
    }
  }

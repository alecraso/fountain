{
  "name": "error-402-without-code-is-insufficient-credits",
  "title": "A bare HTTP 402 is a credit error",
  "contract": "errors",
  "why": "A proxy can omit the JSON code, so HTTP 402 must still identify the credit gate.",
  "client": {
    "api_key": "conformance-key"
  },
  "http": [
    {
      "match": {
        "method": "POST",
        "path": "/api/conversations"
      },
      "respond": {
        "status": 402,
        "body": ""
      }
    }
  ],
  "steps": [
    {
      "op": "run",
      "agent": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee",
      "prompt": "hello"
    }
  ],
  "expect": {
    "error": {
      "kind": "insufficient_credits",
      "status": 402,
      "code": null,
      "retryable": false,
      "upgrade_url": null
    }
  }
}
